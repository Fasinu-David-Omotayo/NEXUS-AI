@'
# Python virtual environments
/backend/venv/
/backend/.venv/
**/venv/
**/.venv/

# Environment files and secrets
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Frontend dependencies and build output
/frontend/node_modules/
/frontend/.next/
/frontend/out/
/frontend/dist/

# Python cache
__pycache__/
*.py[cod]

# Local databases and logs
*.db
*.sqlite
*.sqlite3
*.log

# Private keys and local backups
*.pem
*.key
*.backup
*.bak
'@ | Set-Content -Encoding utf8 .gitignore